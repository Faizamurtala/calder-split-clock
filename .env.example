# Paper only by default. Never put live withdrawal keys here.
CALDER_MODE=paper
CALDER_EQUITY=10000
CALDER_RISK_PCT=0.75
CALDER_MAX_POS=3
CALDER_SYMBOLS=NVDA,TSLA,AAPL,MSFT,AMZN,META,AMD,QQQ

# Optional LLM (OpenAI-compatible). Leave blank to use the rule brain only.
# Bitget Qwen example:
# LLM_BASE_URL=https://hackathon.bitgetops.com/v1
# LLM_MODEL=qwen3.8-max
# LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional Bitget demo / Agent Hub later
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_PAPER=true
